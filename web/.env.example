# Google Places API (New) key, restricted to the Places API. Enables live Google reviews.
GOOGLE_MAPS_API_KEY=
# Google Place ID for Shine Squad (starts with ChIJ...). Find it with Google's Place ID Finder.
GOOGLE_PLACE_ID=
# Resend API key + destination inbox for consultation leads
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
# Google Apps Script web-app URL that appends a row to the leads sheet
LEAD_SHEET_WEBHOOK=
# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=
